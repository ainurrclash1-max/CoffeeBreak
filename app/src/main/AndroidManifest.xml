<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coffee">
        <activity
            android:name=".presentation.auth.TwoFactor"
            android:exported="false"
            android:label="@string/title_activity_two_factor"
            android:theme="@style/Theme.Coffee" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Coffee">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".presentation.auth.Welcome" />
        <activity android:name=".presentation.auth.Menu"/>
        <activity android:name=".presentation.auth.Profile"/>
        <activity android:name=".presentation.auth.QrCode"/>
        <activity android:name=".presentation.auth.Reward"/>
    </application>

</manifest>